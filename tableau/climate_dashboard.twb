  <worksheets>
    <worksheet name='Every country’s daily highs are rising (1990–2025)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Every country’s daily highs are rising (1990–2025)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>0 = each country&apos;s 1991–2020 average. Above 0 = warmer than usual. Dashed line = trend </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>* Canada and Japan not shown: too few stations for a reliable trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='country_yearly_anomalies' name='federated.0pix3c30vjydma1cntkq60n9u3v3' />
          </datasources>
          <datasource-dependencies datasource='federated.0pix3c30vjydma1cntkq60n9u3v3'>
            <column caption='Avg Anomaly' datatype='real' name='[avg_anomaly]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_anomaly]' derivation='Sum' name='[sum:avg_anomaly:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0pix3c30vjydma1cntkq60n9u3v3].[none:country_name:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:country_name:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Canada&quot;' />
                <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Japan&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0pix3c30vjydma1cntkq60n9u3v3].[none:country_name:nk]</column>
          </slices>
          <aggregation value='true' />
